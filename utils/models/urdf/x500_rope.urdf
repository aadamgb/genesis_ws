<?xml version="1.0" ?>

<!-- Holybro X500 (v2), converted from the MRS Gazebo model:
     mrs_uav_gazebo_simulator/models/mrs_robots_description/sdf/drones/x500.sdf.jinja
     Meshes (in meters) copied from mrs_robots_description/meshes/x500v2.

     The drone parameters and their randomization ranges are in hydra_configs/drone/x500.yaml, whose
     nominals are written into Genesis at build. kf and km are in <properties> because Genesis needs them to
     load. Not modelled: rotor_drag_coefficient 1e-4, rolling_moment_coefficient 1e-6. -->

<!-- x500.urdf (des-inf-dom-rand) with the rope of general_rope.urdf hanging from the COM, same link names, for
     visualize_pursuit_evasion.py. -->

<robot name="x500_rope">

  <properties kf="4.605815e-7" km="2.763489e-8" />

  <link name="base_link">

    <!-- gazebo body: solid cylinder r = 0.25, h = 0.05 (1.94 kg), plus the 4 props (thin discs r = 0.1751)
         at (+-0.1812, +-0.1812, 0.057) via the parallel axis theorem; the resulting 1.8 mm COM shift
         upwards is neglected -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.0043"/>
      <inertia ixx="0.03353" ixy="0.0" ixz="0.0" iyy="0.03353" iyz="0.0" izz="0.06583"/>
    </inertial>

    <!-- boards, pixhawk, nuc, battery and gps -->
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/top_board.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/bottom_board.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/pixhawk6c.stl" scale="1 1 1"/>
      </geometry>
      <material name="darkgrey"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/nuc_board.stl" scale="1 1 1"/>
      </geometry>
      <material name="green"><color rgba="0.1 0.5 0.15 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/nuc_cooler.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/nuc_hex_posts.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0.001"/>
      <geometry>
        <mesh filename="./mesh/x500/battery_mount.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0.001"/>
      <geometry>
        <mesh filename="./mesh/x500/battery.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/gps_mount.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/gps_module.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>

    <!-- arms, legs and motor bases: the meshes sit on the front right arm, rotated by 90 deg per arm -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_carbon.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic1.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/leg_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_bottom.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_middle.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_carbon.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic1.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/leg_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_bottom.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_middle.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_carbon.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic1.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/leg_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_bottom.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 3.141593" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_middle.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_carbon.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic1.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/leg_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_bottom.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 4.712389" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_middle.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>

    <!-- collisions as in gazebo: body cylinder r = 0.1, h = 0.1 below the origin and one cylinder per leg -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.05"/>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.13 -0.13 -0.07"/>
      <geometry>
        <cylinder radius="0.015" length="0.165"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.13 0.13 -0.07"/>
      <geometry>
        <cylinder radius="0.015" length="0.165"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.13 0.13 -0.07"/>
      <geometry>
        <cylinder radius="0.015" length="0.165"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.13 -0.13 -0.07"/>
      <geometry>
        <cylinder radius="0.015" length="0.165"/>
      </geometry>
    </collision>

  </link>

  <!-- Rotors in the gazebo order: 0 front right (ccw), 1 back left (ccw), 2 front left (cw), 3 back right (cw),
       same layout as the a300, so propellers_spin=(-1, -1, 1, 1). Thrust is applied at each prop link's
       inertial origin. The first visual is the prop, which Genesis spins; the cw props are mirrored.
       The motor tops are on base_link so they do not spin. -->
  <link name="prop0_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1812 -0.1812 0.057"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.1812 -0.1812 0.057"/>
      <geometry>
        <mesh filename="./mesh/x500/prop.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1812 0.1812 0.057"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 0.1812 0.057"/>
      <geometry>
        <mesh filename="./mesh/x500/prop.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1812 0.1812 0.057"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.1812 0.1812 0.057"/>
      <geometry>
        <mesh filename="./mesh/x500/prop.dae" scale="-1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1812 -0.1812 0.057"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 -0.1812 0.057"/>
      <geometry>
        <mesh filename="./mesh/x500/prop.dae" scale="-1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>

  <link name="motor_tops_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.1812 -0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.1812 0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 -0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="motor_tops_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_tops_link"/>
  </joint>

  <link name="center_of_mass_link">
    <!-- rope from the COM to the first hinge, rigid with the drone -->
    <visual>
      <geometry>
        <cylinder length="0.015" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="center_of_mass_joint" type="fixed">
    <parent link="base_link"/>
    <child link="center_of_mass_link"/>
  </joint>

  <!-- rope of 5 segments (two revolute joints each) hanging from the COM, as in bros300.urdf; the rod
       task welds a rod to segment_5_cylinder, i.e. at the last hinge, 0.075 m below the COM. The visual cylinders
       span hinge to hinge (COM to the first hinge on center_of_mass_link), segment 5 has none -->
<!-- Spherical joint -->
  <link name="segment_1_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="center_of_mass_link_to_segment_1_sphere" type="revolute">
    <parent link="center_of_mass_link"/>
    <child link="segment_1_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_1_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.015" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_1_sphere_to_cylinder" type="revolute">
    <parent link="segment_1_sphere"/>
    <child link="segment_1_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_2_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_1_cylinder_to_segment_2_sphere" type="revolute">
    <parent link="segment_1_cylinder"/>
    <child link="segment_2_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_2_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.015" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_2_sphere_to_cylinder" type="revolute">
    <parent link="segment_2_sphere"/>
    <child link="segment_2_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_3_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_2_cylinder_to_segment_3_sphere" type="revolute">
    <parent link="segment_2_cylinder"/>
    <child link="segment_3_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_3_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.015" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
