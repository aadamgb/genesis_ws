<?xml version="1.0" ?>

<!-- Holybro X500 (v2), converted from the MRS Gazebo model:
     mrs_uav_gazebo_simulator/models/mrs_robots_description/sdf/drones/x500.sdf.jinja
     Meshes (in meters) copied from mrs_robots_description/meshes/x500v2.

     properties: rotor parameters. Mass and inertia are base_link's inertial (1.94 kg body + 4 x 0.01608 kg
     props), the arm is given by the prop link positions (prop_xy_offset 0.1812 * sqrt(2)).
       kf [N/rpm^2]:     motor_constant 4.2e-5 N/(rad/s)^2 * (2 pi / 60)^2, F = kf rpm^2
       km [Nm/rpm^2]:    moment_constant 0.06 m * kf, M = km rpm^2
       max_rpm [rpm]:    max_rot_velocity 780 rad/s
       tau_up/down [s]:  time_constant_up/down, first-order motor lag (informational, set it in the task yaml)
     hover: 3267 rpm (0.44 of max rpm), thrust/weight 5.2. Not modelled here: rotor_drag_coefficient 1e-4,
     rolling_moment_coefficient 1e-6. -->

<robot name="x500">

  <properties kf="4.605815e-7" km="2.763489e-8" max_rpm="7448.451" tau_up="0.0125" tau_down="0.025" />

  <link name="base_link">

    <!-- gazebo body: solid cylinder r = 0.25, h = 0.05 (1.94 kg), plus the 4 props (thin discs r = 0.1751)
         at (+-0.1812, +-0.1812, 0.057) via the parallel axis theorem; the resulting 1.8 mm COM shift
         upwards is neglected -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.0043"/>
      <inertia ixx="0.03353" ixy="0.0" ixz="0.0" iyy="0.03353" iyz="0.0" izz="0.06583"/>
    </inertial>

    <!-- boards, pixhawk, nuc, battery and gps -->
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/top_board.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/bottom_board.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/pixhawk6c.stl" scale="1 1 1"/>
      </geometry>
      <material name="darkgrey"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/nuc_board.stl" scale="1 1 1"/>
      </geometry>
      <material name="green"><color rgba="0.1 0.5 0.15 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/nuc_cooler.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/nuc_hex_posts.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0.001"/>
      <geometry>
        <mesh filename="./mesh/x500/battery_mount.stl" scale="1 1 1"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0.001"/>
      <geometry>
        <mesh filename="./mesh/x500/battery.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/gps_mount.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/gps_module.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>

    <!-- arms, legs and motor bases: the meshes sit on the front right arm, rotated by 90 deg per arm -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_carbon.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic1.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_plastic2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.05 0.3 0.75 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./mesh/x500/arm_3d_print.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
