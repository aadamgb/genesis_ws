      <origin rpy="0 0 0" xyz="-0.1812 -0.1812 0.057"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 -0.1812 0.057"/>
      <geometry>
        <mesh filename="./mesh/x500/prop.dae" scale="-1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>

  <link name="motor_tops_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.1812 -0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.1812 0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1812 -0.1812 0.0484"/>
      <geometry>
        <mesh filename="./mesh/x500/motor_top.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
