<?xml version="1.0" ?>

<robot name="a300_rope">

  <!-- The drone parameters and their randomization ranges are in hydra_configs/drone/a300.yaml, whose
       nominals are written into Genesis at build. kf and km are here because Genesis needs them to load. -->
  <properties kf="4.5e-8" km="5.4e-10" />

  <link name="base_link"> 

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.21"/>
      <inertia ixx=".007" ixy="0.0" ixz="0.0" iyy=".007" iyz="0.0" izz=".01"/>
    </inertial>

    <visual>
      <origin rpy="0 0 55" xyz="0 0 0.075"/>
      <geometry>
        <mesh filename="./mesh/a300/frame.stl" scale="0.001 0.001 0.001"/>
      </geometry> 
      <material name="frame">
        <color rgba="0.2 0.2 0.2 1"/>
      </material> 
    </visual>

    <visual>
      <origin rpy="0 0 55" xyz="0.106 -0.106 0.075"/>
      <geometry>
        <mesh filename="./mesh/a300/motor.stl" scale="0.001 0.001 0.001"/>
      </geometry> 
      <material name="motor">
        <color rgba="0 .0 .0 1"/>
      </material> 
    </visual>
    <visual>
      <origin rpy="0 0 55" xyz="-0.106 0.106 0.075"/>
      <geometry>
        <mesh filename="./mesh/a300/motor.stl" scale="0.001 0.001 0.001"/>
      </geometry> 
      <material name="motor">
        <color rgba="0 .0 .0 1"/>
      </material> 
    </visual>
    <visual>
      <origin rpy="0 0 55" xyz="0.106 0.106 0.075"/>
      <geometry>
        <mesh filename="./mesh/a300/motor.stl" scale="0.001 0.001 0.001"/>
      </geometry> 
      <material name="motor">
        <color rgba="0 .0 .0 1"/>
      </material> 
    </visual>
    <visual>
      <origin rpy="0 0 55" xyz="-0.106 -0.106 0.075"/>
      <geometry>
        <mesh filename="./mesh/a300/motor.stl" scale="0.001 0.001 0.001"/>
      </geometry> 
      <material name="motor">
        <color rgba="0 .0 .0 1"/>
      </material> 
    </visual>


<!-- Added 4 Cylindrical Legs -->
    <visual>
      <origin rpy="0 0 0" xyz="0.106 -0.106 -0.03"/>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.106 0.106 -0.03"/>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.106 0.106 -0.03"/>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.106 -0.106 -0.03"/>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>


    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius=".06" length=".025"/>
      </geometry>
    </collision>  

  </link>

  <!-- Rotor positions match the Gazebo model (alien_gazebo_resources a300.sdf.jinja,
       rotor_xy_offset = 0.1: x = +-0.095, y = +-0.117) instead of the symmetric +-0.106.
       Thrust is applied at each prop link's inertial origin. The frame/motor/leg visuals
       on base_link are unchanged. -->
  <link name="prop0_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.095 -0.117 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.095 -0.117 0.02"/>
      <geometry>
          <mesh filename="./mesh/a300/prop.dae"  scale="0.4 0.4 0.4"/>
      </geometry> 
    </visual>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.095 0.117 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.095 0.117 0.02"/>
      <geometry>
          <mesh filename="./mesh/a300/prop.dae"  scale="0.4 0.4 0.4"/>
      </geometry> 
    </visual>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.095 0.117 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.095 0.117 0.02"/>
      <geometry>
          <mesh filename="./mesh/a300/prop.dae"  scale="0.4 0.4 0.4"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.095 -0.117 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.095 -0.117 0.02"/>
      <geometry>
          <mesh filename="./mesh/a300/prop.dae"  scale="0.4 0.4 0.4"/>
      </geometry>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>


  <link name="center_of_mass_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="center_of_mass_joint" type="fixed">
    <parent link="base_link"/>
    <child link="center_of_mass_link"/>
  </joint>

  <!-- rope of 5 segments (two revolute joints each) hanging from the COM, as in bros300.urdf; the rod
       task welds a rod to segment_5_cylinder -->
<!-- Spherical joint -->
  <link name="segment_1_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="center_of_mass_link_to_segment_1_sphere" type="revolute">
    <parent link="center_of_mass_link"/>
    <child link="segment_1_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_1_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_1_sphere_to_cylinder" type="revolute">
    <parent link="segment_1_sphere"/>
    <child link="segment_1_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_2_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_1_cylinder_to_segment_2_sphere" type="revolute">
    <parent link="segment_1_cylinder"/>
    <child link="segment_2_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_2_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_2_sphere_to_cylinder" type="revolute">
    <parent link="segment_2_sphere"/>
    <child link="segment_2_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_3_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_2_cylinder_to_segment_3_sphere" type="revolute">
    <parent link="segment_2_cylinder"/>
    <child link="segment_3_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_3_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_3_sphere_to_cylinder" type="revolute">
    <parent link="segment_3_sphere"/>
    <child link="segment_3_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_4_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_3_cylinder_to_segment_4_sphere" type="revolute">
    <parent link="segment_3_cylinder"/>
    <child link="segment_4_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_4_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_4_sphere_to_cylinder" type="revolute">
    <parent link="segment_4_sphere"/>
    <child link="segment_4_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_5_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_4_cylinder_to_segment_5_sphere" type="revolute">
    <parent link="segment_4_cylinder"/>
    <child link="segment_5_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_5_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0075"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_5_sphere_to_cylinder" type="revolute">
    <parent link="segment_5_sphere"/>
    <child link="segment_5_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

</robot>
