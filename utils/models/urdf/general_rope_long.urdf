<?xml version="1.0" ?>

<!-- general.urdf (des-inf-dom-rand) with the rope of a300_rope.urdf at twice its length (5 x 3 cm) hanging from the COM,
     for the rod2 task (rod.hang 0.16, spawn_height 2.66).
     General quadrotor for wide domain randomization: two crossed arms and four motor spheres.
     The drone parameters and their randomization ranges are in hydra_configs/drone/general.yaml, whose
     nominals are written into Genesis at build. kf and km are in <properties> because Genesis needs them to
     load. Front motors red, back motors black. -->

<robot name="general_rope">

  <properties kf="4.5e-8" km="5.4e-10" />

  <link name="base_link">

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.016"/>
    </inertial>

    <visual>
      <origin rpy="0 1.570796 0.785398" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.4"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>

    <visual>
      <origin rpy="0 1.570796 -0.785398" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.4"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

  </link>

  <!-- Rotors as on the a300/x500: 0 front right (ccw), 1 back left (ccw), 2 front left (cw), 3 back right (cw),
       so propellers_spin=(-1, -1, 1, 1). Thrust is applied at each prop link's inertial origin. -->
  <link name="prop0_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.141421 -0.141421 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.141421 -0.141421 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.141421 0.141421 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.141421 0.141421 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.141421 0.141421 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.141421 0.141421 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.141421 -0.141421 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.141421 -0.141421 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>




  <link name="center_of_mass_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="center_of_mass_joint" type="fixed">
    <parent link="base_link"/>
    <child link="center_of_mass_link"/>
  </joint>

  <!-- rope of 5 segments (two revolute joints each) hanging from the COM, as in bros300.urdf; the rod
       task welds a rod to segment_5_cylinder -->
<!-- Spherical joint -->
  <link name="segment_1_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="center_of_mass_link_to_segment_1_sphere" type="revolute">
    <parent link="center_of_mass_link"/>
    <child link="segment_1_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_1_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_1_sphere_to_cylinder" type="revolute">
    <parent link="segment_1_sphere"/>
    <child link="segment_1_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_2_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_1_cylinder_to_segment_2_sphere" type="revolute">
    <parent link="segment_1_cylinder"/>
    <child link="segment_2_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_2_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_2_sphere_to_cylinder" type="revolute">
    <parent link="segment_2_sphere"/>
    <child link="segment_2_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_3_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_2_cylinder_to_segment_3_sphere" type="revolute">
    <parent link="segment_2_cylinder"/>
    <child link="segment_3_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_3_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_3_sphere_to_cylinder" type="revolute">
    <parent link="segment_3_sphere"/>
    <child link="segment_3_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_4_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_3_cylinder_to_segment_4_sphere" type="revolute">
    <parent link="segment_3_cylinder"/>
    <child link="segment_4_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_4_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_4_sphere_to_cylinder" type="revolute">
    <parent link="segment_4_sphere"/>
    <child link="segment_4_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Spherical joint -->
  <link name="segment_5_sphere">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_4_cylinder_to_segment_5_sphere" type="revolute">
    <parent link="segment_4_cylinder"/>
    <child link="segment_5_sphere"/>
    <origin rpy="0 0 0" xyz="0 0 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <!-- Cylinder segment -->
  <link name="segment_5_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.005"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="segment_5_sphere_to_cylinder" type="revolute">
    <parent link="segment_5_sphere"/>
    <child link="segment_5_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="3"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

</robot>
